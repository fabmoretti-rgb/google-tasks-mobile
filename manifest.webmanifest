{
  "name": "Tasks GTD",
  "short_name": "Tasks GTD",
  "description": "Google Tasks con strumenti GTD: Oggi, Elabora INBOX, Revisione, Contesti, Deleghe.",
  "lang": "it",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#ffffff",
  "theme_color": "#fdd21f",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Nuova attività", "short_name": "Nuova", "url": "./?new=1", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Oggi", "url": "./?tab=today", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Elabora INBOX", "url": "./?tab=inbox", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ],
  "share_target": {
    "action": "./",
    "method": "GET",
    "params": { "title": "title", "text": "text", "url": "url" }
  }
}
